# Active Assistant Environment Variables
# Copy this to .env and fill in your API keys

# ============================================================
# AI Provider API Keys (at least one required)
# ============================================================

# Groq - Free tier available at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Brave Search - https://brave.com/search/api/
BRAVE_API_KEY=your_brave_search_api_key_here

# ============================================================
# Optional: Override Configuration Values
# ============================================================

# UI Theme: dark, light, system, futuristic
# ACTIVE_ASSISTANT_THEME=dark

# Log Level: DEBUG, INFO, WARNING, ERROR
# ACTIVE_ASSISTANT_LOG_LEVEL=INFO

# Enable Windows Startup
# ACTIVE_ASSISTANT_STARTUP=false

# Local Only Mode (disable cloud APIs)
# ACTIVE_ASSISTANT_LOCAL_ONLY=false